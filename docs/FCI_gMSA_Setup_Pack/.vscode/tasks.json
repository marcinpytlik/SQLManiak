
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "New-gMSA (AD/DC)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/New-gMSA.ps1",
        "-Domain", "sqlmaniak.lab",
        "-GmsaName", "sqlsvc_fci01",
        "-Hosts", "NODE1","NODE2",
        "-HostsGroup", "GRP_SQL_FCI01_GMSA_Hosts",
        "-OuPath", "OU=SQL,DC=sqlmaniak,DC=lab"
      ],
      "problemMatcher": []
    },
    {
      "label": "Install-gMSA (node)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/Install-gMSA-OnNodes.ps1",
        "-GmsaName", "sqlsvc_fci01"
      ],
      "problemMatcher": []
    },
    {
      "label": "Register SPN",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/Register-SPN.ps1",
        "-Domain", "sqlmaniak.lab",
        "-GmsaName", "sqlsvc_fci01",
        "-VnnFqdn", "SQLPROD.sqlmaniak.lab",
        "-Port", "1433"
      ],
      "problemMatcher": []
    }
  ]
}
