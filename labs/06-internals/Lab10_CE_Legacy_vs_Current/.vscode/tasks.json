{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CE_Lab: Setup (DB + dane)",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "master",
        "-E",
        "-b",
        "-i",
        "scripts/01_setup.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CE_Lab: Queries (baseline)",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "CE_Lab",
        "-E",
        "-b",
        "-i",
        "scripts/02_queries.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CE_Lab: Toggle CE legacy/current + run",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "CE_Lab",
        "-E",
        "-b",
        "-i",
        "scripts/03_toggle_ce.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CE_Lab: Per-query hints (CE)",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "CE_Lab",
        "-E",
        "-b",
        "-i",
        "scripts/04_per_query_hints.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CE_Lab: Cleanup",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "CE_Lab",
        "-E",
        "-b",
        "-i",
        "scripts/05_cleanup.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "SqlServer",
      "type": "promptString",
      "description": "Serwer SQL (np. localhost, . , SERVER\\INSTANCE)",
      "default": "localhost"
    }
  ]
}