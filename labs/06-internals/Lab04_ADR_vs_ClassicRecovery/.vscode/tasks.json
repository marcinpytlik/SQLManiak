{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ADR_On_DB: Setup (creates ADR_On_DB & ADR_Off_DB)",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "master",
        "-E",
        "-b",
        "-i",
        "scripts/01_setup.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ADR_On_DB: ADR ON: Long txn & rollback",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "ADR_On_DB",
        "-E",
        "-b",
        "-i",
        "scripts/02_long_txn_rollback_ADR_ON.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ADR_On_DB: ADR OFF: Long txn & rollback",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "ADR_On_DB",
        "-E",
        "-b",
        "-i",
        "scripts/03_long_txn_rollback_ADR_OFF.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ADR_On_DB: PVS Stats & sanity-check",
      "type": "shell",
      "command": "sqlcmd",
      "args": [
        "-S",
        "${input:SqlServer}",
        "-d",
        "ADR_On_DB",
        "-E",
        "-b",
        "-i",
        "scripts/04_pvs_stats.sql"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "SqlServer",
      "type": "promptString",
      "description": "Nazwa serwera SQL (np. localhost, . , SERVER\\INSTANCE)",
      "default": "localhost"
    }
  ]
}