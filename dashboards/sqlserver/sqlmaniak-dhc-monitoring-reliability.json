    {
      "id": 7,
      "type": "table",
      "title": "Current reliability status",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.ServerInstance AS [Instance],s.Environment,s.MonitorGroup AS [Monitor group],\n CASE WHEN s.IsOverdue=1 THEN 'STALE' WHEN s.MonitoringStatus='FAILED' THEN 'FAILED' WHEN s.MonitoringStatus='PARTIAL' THEN 'PARTIAL'\n WHEN s.MonitoringStatus='NO_DATA' THEN 'NO_DATA' WHEN s.MonitoringStatus='RUNNING' AND s.LastAttemptUTC<=DATEADD(MINUTE,-${running_threshold:raw},SYSUTCDATETIME()) THEN 'SUSPECT_RUNNING'\n ELSE s.MonitoringStatus END AS [Reliability status],\n s.MonitoringStatus AS [Collection],CASE WHEN s.IsOverdue=1 THEN 'YES' ELSE 'NO' END AS [Overdue],\n s.IntervalMinutes AS [Expected interval min],s.LastAttemptUTC AS [Last attempt UTC],s.LastCompleteUTC AS [Last complete UTC],\n s.MinutesSinceAttempt AS [Minutes since attempt],s.MinutesSinceComplete AS [Minutes since complete],\n CASE WHEN s.MonitoringStatus='RUNNING' THEN DATEDIFF_BIG(MINUTE,s.LastAttemptUTC,SYSUTCDATETIME()) ELSE NULL END AS [Running age min],\n s.LastRowsStored AS [Rows stored],LEFT(s.LastErrorText,350) AS [Last error] FROM dhc.vMonitoringStatus s WHERE s.IsEnabled=1 AND s.Environment IN (${environment:sqlstring}) AND s.ServerInstance IN (${instance:sqlstring})\n ORDER BY CASE WHEN s.IsOverdue=1 THEN 0 WHEN s.MonitoringStatus='FAILED' THEN 1 WHEN s.MonitoringStatus='PARTIAL' THEN 2 WHEN s.MonitoringStatus='RUNNING' THEN 3 WHEN s.MonitoringStatus='NO_DATA' THEN 4 ELSE 5 END,s.ServerInstance;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
