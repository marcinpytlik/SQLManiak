    {
      "id": 8,
      "type": "table",
      "title": "FAILED / PARTIAL execution history",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP(100) e.StartedUTC AS [Started UTC],e.ServerInstance AS [Instance],e.Status AS [Result],\n e.RowsStored AS [Rows],DATEDIFF_BIG(MILLISECOND,e.StartedUTC,e.FinishedUTC) AS [Duration ms],LEFT(e.ErrorText,500) AS [Error]\n FROM dhc.ExecutionLog e JOIN dhc.MonitoredServer s ON s.ServerInstance=e.ServerInstance\n WHERE s.IsEnabled=1 AND s.Environment IN (${environment:sqlstring}) AND s.ServerInstance IN (${instance:sqlstring}) AND $__timeFilter(e.StartedUTC) AND e.Status IN ('FAILED','PARTIAL')\n ORDER BY e.StartedUTC DESC,e.ExecutionId DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
