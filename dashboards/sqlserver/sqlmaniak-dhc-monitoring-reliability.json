          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.ServerInstance AS [Instance],s.Environment,s.IntervalMinutes AS [Target interval min],s.LastAttemptUTC AS [Last attempt UTC],\n s.LastCompleteUTC AS [Last complete UTC],s.MinutesSinceAttempt AS [Minutes since attempt],s.MinutesSinceComplete AS [Minutes since complete],\n CASE WHEN s.LastCompleteUTC IS NULL THEN 'NO_SUCCESS' WHEN s.MinutesSinceComplete>s.IntervalMinutes THEN 'SUCCESS_AGED' ELSE 'RECENT_SUCCESS' END AS [Last success freshness]\n FROM dhc.vMonitoringStatus s WHERE s.IsEnabled=1 AND s.Environment IN (${environment:sqlstring}) AND s.ServerInstance IN (${instance:sqlstring}) ORDER BY CASE WHEN s.LastCompleteUTC IS NULL THEN 0 WHEN s.MinutesSinceComplete>s.IntervalMinutes THEN 1 ELSE 2 END,s.ServerInstance;"
        }
