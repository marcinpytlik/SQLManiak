    {
      "id": 9,
      "type": "timeseries",
      "title": "Collections by outcome · hourly",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CAST(DATEADD(HOUR,DATEDIFF(HOUR,0,e.StartedUTC),0) AS datetime) AS time,\n SUM(CASE WHEN e.Status='COMPLETE' THEN 1 ELSE 0 END) AS [COMPLETE],\n SUM(CASE WHEN e.Status='PARTIAL' THEN 1 ELSE 0 END) AS [PARTIAL],\n SUM(CASE WHEN e.Status='FAILED' THEN 1 ELSE 0 END) AS [FAILED]\n FROM dhc.ExecutionLog e JOIN dhc.MonitoredServer s ON s.ServerInstance=e.ServerInstance\n WHERE s.IsEnabled=1 AND s.Environment IN (${environment:sqlstring}) AND s.ServerInstance IN (${instance:sqlstring}) AND $__timeFilter(e.StartedUTC)\n GROUP BY DATEADD(HOUR,DATEDIFF(HOUR,0,e.StartedUTC),0) ORDER BY time;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
