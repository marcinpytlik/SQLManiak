          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP(100) e.ServerInstance AS [Instance],s.Environment,e.StartedUTC AS [Started UTC],\n DATEDIFF_BIG(MINUTE,e.StartedUTC,SYSUTCDATETIME()) AS [Running age min],\n CASE WHEN e.StartedUTC<=DATEADD(MINUTE,-${running_threshold:raw},SYSUTCDATETIME()) THEN 'SUSPECT' ELSE 'RECENT' END AS [Assessment],\n CONVERT(varchar(36),e.ExecutionId) AS [Execution ID]\n FROM dhc.ExecutionLog e JOIN dhc.MonitoredServer s ON s.ServerInstance=e.ServerInstance\n WHERE s.IsEnabled=1 AND s.Environment IN (${environment:sqlstring}) AND s.ServerInstance IN (${instance:sqlstring}) AND e.Status='RUNNING' ORDER BY e.StartedUTC ASC;"
