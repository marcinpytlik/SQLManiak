    },
    {
      "id": 7,
      "title": "TempDB · latest file/growth inventory",
      "type": "table",
      "description": "Latest TempDBSnapshot join to TempDBFile; file growth assessment is per file.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "WITH recent AS (SELECT TOP(1) r.RunId,r.StartedUTC FROM dhc.Run r JOIN dhc.TempDBSnapshot t ON t.RunId=r.RunId WHERE r.ServerInstance=${instance:sqlstring} ORDER BY r.StartedUTC DESC,r.RunId DESC) SELECT recent.StartedUTC AS [Snapshot UTC],f.FileId AS [File ID],f.FileType AS [File type],f.FileName AS [File name],f.VolumeMountPoint AS [Volume],f.SizeMB AS [Size MB],f.MaxSizeMB AS [Max MB],f.GrowthMB AS [Growth MB],CASE WHEN f.IsPercentGrowth=1 THEN 'YES' ELSE 'NO' END AS [Percent growth],f.NextGrowthMB AS [Next growth MB],CASE WHEN f.NextGrowthWillFit=1 THEN 'YES' WHEN f.NextGrowthWillFit=0 THEN 'NO' ELSE 'UNKNOWN' END AS [Growth will fit],f.AvailableVolumeMB AS [Volume free MB] FROM recent JOIN dhc.TempDBFile f ON f.RunId=recent.RunId ORDER BY f.FileId;",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Growth will fit"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "YES": {
                        "text": "YES",
                        "color": "green"
                      },
                      "NO": {
                        "text": "NO",
                        "color": "red"
                      },
                      "UNKNOWN": {
                        "text": "UNKNOWN",
                        "color": "gray"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
