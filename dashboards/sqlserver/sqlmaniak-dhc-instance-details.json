    {
      "id": 8,
      "title": "Collection execution history",
      "type": "table",
      "description": "Up to 100 attempts in the selected time range, including unsuccessful attempts.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "SELECT TOP(100) e.StartedUTC AS [Started UTC],e.FinishedUTC AS [Finished UTC],e.Status AS [Collection],e.RowsStored AS [Rows],DATEDIFF_BIG(MILLISECOND,e.StartedUTC,e.FinishedUTC) AS [Duration ms],LEFT(e.ErrorText,600) AS [Error],CONVERT(varchar(36),e.RunId) AS [Run ID] FROM dhc.ExecutionLog e WHERE e.ServerInstance=${instance:sqlstring} AND $__timeFilter(e.StartedUTC) ORDER BY e.StartedUTC DESC,e.ExecutionId DESC;",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
