  "panels": [
    {
      "id": 1,
      "title": "SQL diagnostic health · last snapshot",
      "type": "stat",
      "description": "Integer status mapped in Grafana to OK (0), WARNING (1), CRITICAL (2), STALE (3), NO_DATA (4); from latest COMPLETE/PARTIAL snapshot, not realtime.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "SELECT CAST(CASE WHEN latest.RunId IS NULL THEN 4 WHEN s.IsOverdue=1 THEN 3 WHEN a.CriticalCount>0 THEN 2 WHEN a.WarningCount>0 THEN 1 ELSE 0 END AS int) AS value FROM dhc.vMonitoringStatus s OUTER APPLY (SELECT TOP(1) r.RunId FROM dhc.Run r WHERE r.ServerInstance=s.ServerInstance AND r.Status IN ('COMPLETE','PARTIAL') ORDER BY r.StartedUTC DESC,r.RunId DESC) latest OUTER APPLY (SELECT COUNT_BIG(CASE WHEN Severity='CRITICAL' THEN 1 END) AS CriticalCount,COUNT_BIG(CASE WHEN Severity='WARNING' THEN 1 END) AS WarningCount FROM dhc.Alert WHERE RunId=latest.RunId) a WHERE s.ServerInstance=${instance:sqlstring};",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              },
              {
                "color": "purple",
                "value": 3
              },
              {
                "color": "gray",
                "value": 4
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "WARNING",
                  "color": "orange"
                },
                "2": {
                  "text": "CRITICAL",
                  "color": "red"
                },
                "3": {
                  "text": "STALE",
                  "color": "purple"
                },
                "4": {
                  "text": "NO_DATA",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Collection · state and freshness",
      "type": "table",
      "description": "Collection status is separate from diagnostics; overdue depends on repository interval.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "SELECT s.ServerInstance AS [Instance], s.DisplayName AS [Display name], s.Environment,s.MonitorGroup AS [Monitor group],s.MonitoringStatus AS [Collection], CASE WHEN s.IsOverdue=1 THEN 'YES' ELSE 'NO' END AS [Overdue], s.IntervalMinutes AS [Interval min],s.LastAttemptUTC AS [Last attempt UTC],s.LastCompleteUTC AS [Last complete UTC],s.MinutesSinceAttempt AS [Minutes since attempt],s.MinutesSinceComplete AS [Minutes since complete],s.LastRowsStored AS [Rows stored],LEFT(s.LastErrorText,500) AS [Last error] FROM dhc.vMonitoringStatus s WHERE s.ServerInstance=${instance:sqlstring};",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Collection"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "COMPLETE": {
                        "text": "COMPLETE",
                        "color": "green"
                      },
                      "FAILED": {
                        "text": "FAILED",
                        "color": "red"
                      },
                      "PARTIAL": {
                        "text": "PARTIAL",
                        "color": "orange"
                      },
                      "RUNNING": {
                        "text": "RUNNING",
                        "color": "blue"
                      },
                      "NO_DATA": {
                        "text": "NO_DATA",
                        "color": "gray"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Overdue"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "YES": {
                        "text": "YES",
                        "color": "red"
                      },
                      "NO": {
                        "text": "NO",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "title": "Latest diagnostic alerts",
      "type": "table",
      "description": "Alerts from latest COMPLETE/PARTIAL diagnostic snapshot. Empty means no alerts or no snapshot.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "WITH recent AS (SELECT TOP(1) r.RunId,r.StartedUTC FROM dhc.Run r WHERE r.ServerInstance=${instance:sqlstring} AND r.Status IN ('COMPLETE','PARTIAL') ORDER BY r.StartedUTC DESC,r.RunId DESC) SELECT r.StartedUTC AS [Snapshot UTC],a.Severity,a.Area,a.ObjectName AS [Object],a.Details FROM recent r JOIN dhc.Alert a ON a.RunId=r.RunId ORDER BY CASE a.Severity WHEN 'CRITICAL' THEN 0 WHEN 'WARNING' THEN 1 ELSE 2 END,a.Area,a.AlertId;",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "title": "TempDB · latest snapshot",
      "type": "table",
      "description": "Read-only latest available TempDB measurement. Empty if collector did not store a snapshot.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "SELECT TOP(1) t.StartedUTC AS [Snapshot UTC],t.TotalDataMB AS [Data allocated MB],t.UsedDataMB AS [Data used MB],t.FreeDataMB AS [Data free MB],t.DataFreePct AS [Data free %],t.VersionStoreMB AS [Version store MB],t.VersionStoreShareUsedPct AS [Version store share %],t.TotalLogMB AS [Log allocated MB],t.UsedLogMB AS [Log used MB],t.LogFreePct AS [Log free %],t.MinDriveFreePct AS [Min drive free %],CASE WHEN t.AnyFileCannotGrow=1 THEN 'YES' WHEN t.AnyFileCannotGrow=0 THEN 'NO' ELSE 'UNKNOWN' END AS [File cannot grow],t.ActiveVersioningTransactions AS [Versioning transactions],t.OldestVersioningSeconds AS [Oldest versioning seconds] FROM dhc.vTempDBTrend t WHERE t.ServerInstance=${instance:sqlstring} ORDER BY t.StartedUTC DESC,t.RunId DESC;",
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "File cannot grow"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "YES": {
                        "text": "YES",
                        "color": "red"
                      },
                      "NO": {
                        "text": "NO",
                        "color": "green"
                      },
                      "UNKNOWN": {
                        "text": "UNKNOWN",
                        "color": "gray"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "title": "TempDB · data used and version store (MB)",
      "type": "timeseries",
      "description": "Daily snapshots, not continuous realtime measurement. Time range controls points.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
