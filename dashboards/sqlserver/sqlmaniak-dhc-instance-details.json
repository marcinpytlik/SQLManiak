        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DHC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "SELECT t.StartedUTC AS time,t.UsedLogMB AS [Log used MB],t.TotalLogMB AS [Log allocated MB] FROM dhc.vTempDBTrend t WHERE t.ServerInstance=${instance:sqlstring} AND $__timeFilter(t.StartedUTC) ORDER BY t.StartedUTC;",
          "editorMode": "code",
          "format": "time_series"
        }
      ],
