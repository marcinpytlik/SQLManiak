        "refresh": 1,
        "query": "SELECT ServerInstance AS __text,ServerInstance AS __value FROM dhc.MonitoredServer WHERE IsEnabled=1 ORDER BY ServerInstance",
        "definition": "SELECT ServerInstance AS __text,ServerInstance AS __value FROM dhc.MonitoredServer WHERE IsEnabled=1 ORDER BY ServerInstance",
