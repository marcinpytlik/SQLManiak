          "datasource": {
            "type": "mssql",
            "uid": "${DS_DHC}"
          },
          "rawQuery": true,
          "rawSql": "SELECT t.StartedUTC AS time,t.UsedDataMB AS [Data used MB],t.VersionStoreMB AS [Version store MB] FROM dhc.vTempDBTrend t WHERE t.ServerInstance=${instance:sqlstring} AND $__timeFilter(t.StartedUTC) ORDER BY t.StartedUTC;",
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
