<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="2026-09-12T22:45:00"
  DTS:CreationName="Microsoft.Package"
  DTS:CreatorComputerName="SQL64"
  DTS:CreatorName="SQLManiak POC"
  DTS:Description="POC Stage 4 - write a test file to SMB share through SQL Agent SSIS Proxy"
  DTS:DTSID="{3D4138FA-DB34-4BF6-8D88-D584017A6332}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="16.0.1000.6"
  DTS:LocaleID="1033"
  DTS:ObjectName="WriteShareTest"
  DTS:PackageType="5"
  DTS:ProtectionLevel="0"
  DTS:VersionBuild="1"
  DTS:VersionGUID="{1130F9E0-6F6A-472A-8A1F-B97831A6A4A7}">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Write test file to SMB share"
      DTS:CreationName="Microsoft.ExecuteProcess"
      DTS:Description="Runs Windows PowerShell under the SQL Agent Proxy identity and writes a diagnostic file to the test SMB share."
      DTS:DTSID="{D599E8BC-E374-4E18-A97A-98F0EC812C52}"
      DTS:ExecutableType="Microsoft.ExecuteProcess"
      DTS:LocaleID="-1"
      DTS:ObjectName="Write test file to SMB share"
      DTS:TaskContact="Execute Process Task;Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <ExecuteProcessData
          Executable="C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
          Arguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;&amp; { $ErrorActionPreference='Stop'; $share='\\DC01\SSISLab$'; $file=Join-Path $share ('ssis-proxy-test-{0}.txt' -f (Get-Date -Format 'yyyyMMdd-HHmmss-fff')); $identity=[System.Security.Principal.WindowsIdentity]::GetCurrent().Name; $content=@('POC Secure SSIS Export - Stage 4',('Timestamp={0}' -f (Get-Date -Format 'o')),('MachineName={0}' -f $env:COMPUTERNAME),('WindowsIdentity={0}' -f $identity),('OutputFile={0}' -f $file)); $content | Set-Content -LiteralPath $file -Encoding UTF8; if(-not (Test-Path -LiteralPath $file)){ throw 'Output file was not created.' } }&quot;"
          WorkingDirectory="C:\Windows\System32\WindowsPowerShell\v1.0\"
          FailTaskIfReturnCodeIsNotSuccessValue="True"
          SuccessValue="0"
          TimeOut="60"
          TerminateAfterTimeout="True"
          WindowStyle="Hidden" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
</DTS:Executable>
