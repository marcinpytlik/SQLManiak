      "type": "shell",
      "command": "sqlcmd -S \"${config:replication.server}\" -E -v MailOperator=\"${config:replication.mailOperator}\" -i \"${workspaceFolder}/sqlagent/Create-ReplicationErrorEmailJob.sql\""
