      "id": 1,
      "title": "Database resource ranking",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DBACENTRALREPOSITORY}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DBACENTRALREPOSITORY}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "EXEC perf.usp_GetDatabaseLoadRanking @InstanceId=$InstanceId, @From=$__timeFrom(), @To=$__timeTo(), @Top=30;",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Buffer Pool by database",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DBACENTRALREPOSITORY}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DBACENTRALREPOSITORY}"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT [Time] AS time, DatabaseName AS metric, BufferPoolMB AS value FROM report.vGrafanaPerformanceTimeSeries WHERE InstanceId=$InstanceId AND $__timeFilter([Time]) ORDER BY [Time];",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
