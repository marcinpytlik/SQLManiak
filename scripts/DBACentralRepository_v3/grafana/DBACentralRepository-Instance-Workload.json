        {
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DBACENTRALREPOSITORY}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DatabaseName,RecoveryModelDesc,LastFull,LastDiff,LastLog,BackupStatus FROM report.vGrafanaBackupStatus WHERE InstanceId=$InstanceId ORDER BY BackupStatus,DatabaseName;",
          "refId": "A"
        }
      ],
      "options": {},
