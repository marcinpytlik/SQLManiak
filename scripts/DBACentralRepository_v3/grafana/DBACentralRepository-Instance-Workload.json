      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DBACENTRALREPOSITORY}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DBACENTRALREPOSITORY}"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT [Time] AS time, DatabaseName AS metric, BlockedRequests AS value FROM report.vGrafanaPerformanceTimeSeries WHERE InstanceId=$InstanceId AND $__timeFilter([Time]) ORDER BY [Time];",
