      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DBACENTRALREPOSITORY}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DBACENTRALREPOSITORY}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DatabaseName,StateDesc,RecoveryModelDesc,CompatibilityLevel,CAST(TotalSizeMB/1024.0 AS decimal(19,2)) AS TotalSizeGB,IsQueryStoreOn,IsEncrypted FROM report.vGrafanaDatabases WHERE InstanceId=$InstanceId ORDER BY TotalSizeMB DESC;",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
