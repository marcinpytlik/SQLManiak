      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Assessment history",
          "description": "Patch assessment history in the selected Grafana time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT TOP (500)\n    CAST(\n        pa.AssessedAt\n            AT TIME ZONE 'Central European Standard Time'\n            AT TIME ZONE 'UTC'\n        AS datetime2\n    ) AS AssessedAt,\n    i.ServerInstance,\n    e.EnvironmentCode,\n    pa.CurrentVersion,\n    pa.RecommendedVersion,\n    pa.AssessmentStatus,\n    pa.MissingReleaseCount,\n    pa.IsEndOfSupport,\n    pa.Notes\nFROM patch.PatchAssessment AS pa\nJOIN dbo.Instance AS i\n    ON i.InstanceId = pa.InstanceId\nLEFT JOIN dbo.Environment AS e\n    ON e.EnvironmentId = i.EnvironmentId\nWHERE\n    CAST(\n        pa.AssessedAt\n            AT TIME ZONE 'Central European Standard Time'\n            AT TIME ZONE 'UTC'\n        AS datetime2\n    )\n    BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY\n    pa.AssessedAt DESC,\n    pa.PatchAssessmentId DESC;"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
