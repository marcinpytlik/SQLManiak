      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Support / catalog risks",
          "description": "Instances with end-of-support or unknown catalog state.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    ServerInstance,\n    EnvironmentCode,\n    CurrentVersion,\n    RecommendedVersion,\n    AssessmentStatus,\n    MissingReleaseCount,\n    IsEndOfSupport,\n    Notes\nFROM report.vGrafanaPatchStatus\nWHERE\n       IsEndOfSupport = 1\n    OR AssessmentStatus IN ('EOS', 'UNKNOWN')\n    OR AssessmentStatus IS NULL\nORDER BY\n    IsEndOfSupport DESC,\n    ServerInstance;"
                      }
