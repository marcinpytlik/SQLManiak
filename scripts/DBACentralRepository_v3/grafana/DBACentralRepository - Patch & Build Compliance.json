      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Current vs recommended build",
          "description": "Current inventory version compared with the latest patch assessment.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    ServerInstance,\n    EnvironmentCode,\n    InventoryVersion,\n    AssessedAt,\n    CurrentVersion,\n    RecommendedVersion,\n    AssessmentStatus,\n    MissingReleaseCount,\n    IsEndOfSupport,\n    Notes\nFROM report.vGrafanaPatchStatus\nORDER BY\n    CASE ISNULL(AssessmentStatus, 'UNKNOWN')\n        WHEN 'EOS' THEN 1\n        WHEN 'OUTDATED' THEN 2\n        WHEN 'UNKNOWN' THEN 3\n        WHEN 'AHEAD' THEN 4\n        WHEN 'CURRENT' THEN 5\n        ELSE 6\n    END,\n    ServerInstance;"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
