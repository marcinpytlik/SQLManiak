                                "text": "UNKNOWN",
                                "color": "orange",
                                "index": 3
                              },
                              "AHEAD": {
                                "text": "AHEAD",
                                "color": "blue",
                                "index": 4
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
