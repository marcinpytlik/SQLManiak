      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Instances requiring attention",
          "description": "Instances that are not currently on the recommended build.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    ServerInstance,\n    EnvironmentCode,\n    InventoryVersion,\n    CurrentVersion,\n    RecommendedVersion,\n    AssessmentStatus,\n    MissingReleaseCount,\n    IsEndOfSupport,\n    Notes\nFROM report.vGrafanaPatchStatus\nWHERE ISNULL(AssessmentStatus, 'UNKNOWN') <> 'CURRENT'\nORDER BY\n    CASE ISNULL(AssessmentStatus, 'UNKNOWN')\n        WHEN 'EOS' THEN 1\n        WHEN 'OUTDATED' THEN 2\n        WHEN 'UNKNOWN' THEN 3\n        WHEN 'AHEAD' THEN 4\n        ELSE 5\n    END,\n    MissingReleaseCount DESC,\n    ServerInstance;"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
