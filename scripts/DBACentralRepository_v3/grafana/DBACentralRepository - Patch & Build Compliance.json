      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Compliance by environment",
          "description": "Current patch compliance grouped by environment.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    COALESCE(EnvironmentCode, 'UNKNOWN') AS EnvironmentCode,\n    COUNT(*) AS InstanceCount,\n    SUM(CASE WHEN AssessmentStatus = 'CURRENT' THEN 1 ELSE 0 END) AS CurrentCount,\n    SUM(CASE WHEN AssessmentStatus = 'OUTDATED' THEN 1 ELSE 0 END) AS OutdatedCount,\n    SUM(CASE WHEN AssessmentStatus = 'EOS' THEN 1 ELSE 0 END) AS EndOfSupportCount,\n    SUM(CASE WHEN AssessmentStatus = 'UNKNOWN' OR AssessmentStatus IS NULL THEN 1 ELSE 0 END) AS UnknownCount,\n    SUM(CASE WHEN AssessmentStatus = 'AHEAD' THEN 1 ELSE 0 END) AS AheadCount\nFROM report.vGrafanaPatchStatus\nGROUP BY COALESCE(EnvironmentCode, 'UNKNOWN')\nORDER BY OutdatedCount DESC, EndOfSupportCount DESC, EnvironmentCode;"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
