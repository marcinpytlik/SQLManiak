      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Patch compliance summary",
          "description": "Current patch assessment status across enabled SQL Server instances.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    COALESCE(AssessmentStatus, 'UNKNOWN') AS AssessmentStatus,\n    COUNT(*) AS InstanceCount\nFROM report.vGrafanaPatchStatus\nGROUP BY COALESCE(AssessmentStatus, 'UNKNOWN')\nORDER BY InstanceCount DESC, AssessmentStatus;"
                      }
                    }
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "AssessmentStatus"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "CURRENT": {
                                "text": "CURRENT",
                                "color": "green",
                                "index": 0
                              },
                              "OUTDATED": {
                                "text": "OUTDATED",
                                "color": "yellow",
                                "index": 1
                              },
                              "EOS": {
                                "text": "EOS",
