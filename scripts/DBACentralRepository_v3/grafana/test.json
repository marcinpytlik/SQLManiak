{
  "kind": "Dashboard",
  "apiVersion": "dashboard.grafana.app/v2",
  "metadata": {
    "name": "sqlmaniak-test"
  },
  "spec": {
    "title": "SQLManiak - Test deployment",
    "description": "Prosty dashboard testowy wdrażany z GitHub Actions.",
    "timeSettings": {
      "from": "now-1h",
      "to": "now",
      "timezone": "browser"
    },
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "title": "GitHub Actions deployment test",
          "description": "Jeżeli widzisz ten panel, deployment JSON -> GitHub Actions -> Grafana działa.",
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "2.0.0",
            "spec": {
              "options": {
                "mode": "markdown",
                "content": "# SQLManiak\n\n✅ Dashboard utworzony automatycznie z repozytorium GitHub.\n\n**Pipeline działa poprawnie.**"
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              },
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 8
            }
          }
        ]
      }
    }
  }
}