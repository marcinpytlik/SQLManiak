      },
      "datasource": {
        "type": "mssql",
        "uid": "${DS_DBACENTRALREPOSITORY}"
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "${DS_DBACENTRALREPOSITORY}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT TOP (20) EnvironmentCode,ServerInstance,DatabaseName,CAST(TotalSizeMB/1024.0 AS decimal(19,2)) AS TotalSizeGB,StateDesc,RecoveryModelDesc FROM report.vGrafanaDatabases ORDER BY TotalSizeMB DESC;",
