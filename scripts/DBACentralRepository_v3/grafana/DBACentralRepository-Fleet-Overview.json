          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EnvironmentCode,ServerInstance,ProductVersion,Edition,IsClustered,IsHadrEnabled,IsReachable,LastSeenAt FROM report.vGrafanaInstances ORDER BY EnvironmentCode,ServerInstance;",
