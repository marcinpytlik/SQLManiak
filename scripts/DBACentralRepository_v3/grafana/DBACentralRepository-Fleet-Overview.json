          "datasource": {
            "type": "mssql",
            "uid": "${DS_DBACENTRALREPOSITORY}"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EnvironmentCode,ServerInstance,DatabaseName,RecoveryModelDesc,LastFull,LastLog,BackupStatus FROM report.vGrafanaBackupStatus WHERE BackupStatus <> 'OK' ORDER BY BackupStatus,ServerInstance,DatabaseName;",
