                                "text": "OK"
                              },
                              "WARNING": {
                                "color": "yellow",
                                "index": 1,
                                "text": "WARNING"
                              },
                              "CRITICAL": {
                                "color": "red",
                                "index": 2,
                                "text": "CRITICAL"
                              },
                              "NEVER_RUN": {
                                "color": "purple",
                                "index": 3,
                                "text": "NEVER_RUN"
                              },
                              "DISABLED": {
                                "color": "gray",
                                "index": 4,
                                "text": "DISABLED"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      }
                    ]
                  }
