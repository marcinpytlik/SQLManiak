{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "dbacr-collector-health",
    "annotations": {
      "grafana.app/folder": "dbacentralrepository"
    },
    "labels": {}
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Collector health",
          "description": "Current health and freshness state of DBACentralRepository collectors.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    CollectorName,\n    HealthStatus,\n    LastStatus,\n    LastSuccessAt,\n    MinutesSinceSuccess,\n    ExpectedIntervalMinutes,\n    WarningAfterMinutes,\n    CriticalAfterMinutes,\n    CollectorHost,\n    DurationMs,\n    ErrorMessage\nFROM report.vCollectorHealth\nORDER BY\n    CASE HealthStatus\n        WHEN 'CRITICAL'  THEN 1\n        WHEN 'WARNING'   THEN 2\n        WHEN 'NEVER_RUN' THEN 3\n        WHEN 'OK'        THEN 4\n        WHEN 'DISABLED'  THEN 5\n        ELSE 6\n    END,\n    CollectorName;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "HealthStatus"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "OK": {
                                "color": "green",
                                "index": 0,
                                "text": "OK"
                              },
                              "WARNING": {
                                "color": "yellow",
                                "index": 1,
                                "text": "WARNING"
                              },
                              "CRITICAL": {
                                "color": "red",
                                "index": 2,
                                "text": "CRITICAL"
                              },
                              "NEVER_RUN": {
                                "color": "purple",
                                "index": 3,
                                "text": "NEVER_RUN"
                              },
                              "DISABLED": {
                                "color": "gray",
                                "index": 4,
                                "text": "DISABLED"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Status summary",
          "description": "Number of collectors in each health state.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    HealthStatus,\n    COUNT(*) AS CollectorCount\nFROM report.vCollectorHealth\nGROUP BY HealthStatus\nORDER BY\n    CASE HealthStatus\n        WHEN 'CRITICAL'  THEN 1\n        WHEN 'WARNING'   THEN 2\n        WHEN 'NEVER_RUN' THEN 3\n        WHEN 'OK'        THEN 4\n        WHEN 'DISABLED'  THEN 5\n        ELSE 6\n    END;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "HealthStatus"
                    },
                    "properties": [
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "OK": {
                                "color": "green",
                                "index": 0,
                                "text": "OK"
                              },
                              "WARNING": {
                                "color": "yellow",
                                "index": 1,
                                "text": "WARNING"
                              },
                              "CRITICAL": {
                                "color": "red",
                                "index": 2,
                                "text": "CRITICAL"
                              },
                              "NEVER_RUN": {
                                "color": "purple",
                                "index": 3,
                                "text": "NEVER_RUN"
                              },
                              "DISABLED": {
                                "color": "gray",
                                "index": 4,
                                "text": "DISABLED"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-background"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Stale / unhealthy collectors",
          "description": "Collectors that currently require operator attention.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mssql",
                      "version": "v0",
                      "datasource": {
                        "name": "cfvow0j9mkef4c"
                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    CollectorName,\n    HealthStatus,\n    LastSuccessAt,\n    MinutesSinceSuccess,\n    ExpectedIntervalMinutes,\n    WarningAfterMinutes,\n    CriticalAfterMinutes,\n    ErrorMessage\nFROM report.vCollectorHealth\nWHERE HealthStatus <> 'OK'\nORDER BY\n    CASE HealthStatus\n        WHEN 'CRITICAL'  THEN 1\n        WHEN 'WARNING'   THEN 2\n        WHEN 'NEVER_RUN' THEN 3\n        WHEN 'DISABLED'  THEN 4\n        ELSE 5\n    END,\n    MinutesSinceSuccess DESC;"
