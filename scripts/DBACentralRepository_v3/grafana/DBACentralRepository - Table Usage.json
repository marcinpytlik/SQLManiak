                      },
                      "spec": {
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT TOP (50) SchemaName,TableName,SUM(AccessCount) AS AccessCount,SUM(TechnicalAccessCount) AS TechnicalAccessCount,CAST(100.0*SUM(TechnicalAccessCount)/NULLIF(SUM(AccessCount),0) AS decimal(9,2)) AS TechnicalPercent FROM report.vTableUsageDaily WHERE ServerInstance='$ServerInstance' AND DatabaseName='$DatabaseName' AND $__timeFilter(CAST(UsageDateUtc AS datetime2)) GROUP BY SchemaName,TableName HAVING SUM(AccessCount)>0 ORDER BY TechnicalPercent DESC,AccessCount DESC;"
