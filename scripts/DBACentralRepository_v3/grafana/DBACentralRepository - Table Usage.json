                        "rawQuery": true,
                        "rawSql": "SELECT TOP (50) SchemaName,TableName,SUM(AccessCount) AS AccessCount,SUM(TechnicalAccessCount) AS TechnicalAccessCount,SUM(OtherAccessCount) AS OtherAccessCount FROM report.vTableUsageDaily WHERE ServerInstance='$ServerInstance' AND DatabaseName='$DatabaseName' AND $__timeFilter(CAST(UsageDateUtc AS datetime2)) GROUP BY SchemaName,TableName ORDER BY AccessCount DESC;"
